{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "../dist-electron",
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "../src/media/**/*.ts",
    "../src/settings/**/*.ts",
    "../src/ipc/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "../src/**/*.test.ts", "../src/components/**", "../src/App.tsx", "../src/main.tsx"]
}
